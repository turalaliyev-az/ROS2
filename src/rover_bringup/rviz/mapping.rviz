Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Color: 100; 100; 100
      Cell Size: 1

    - Class: rviz_default_plugins/Map
      Name: SLAM Map
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
      Color Scheme: map
      Alpha: 0.7

    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
      Show Axes: true
      Marker Scale: 0.3

    - Class: rviz_default_plugins/LaserScan
      Name: Lidar Scan (LD19)
      Enabled: true
      Topic:
        Value: /scan
      Color: 255; 0; 0
      Size (m): 0.04
      Style: Flat Squares

    - Class: rviz_default_plugins/LaserScan
      Name: RealSense Depth Scan
      Enabled: true
      Topic:
        Value: /camera_scan
      Color: 0; 255; 255
      Size (m): 0.04
      Style: Flat Squares

    - Class: rviz_default_plugins/PointCloud2
      Name: RealSense Point Cloud
      Enabled: false
      Topic:
        Value: /camera/camera/depth/color/points
      Style: Flat Squares
      Size (m): 0.01
      Color Transformer: AxisColor
      Axis: Z

    - Class: rviz_default_plugins/Odometry
      Name: Odometry Trail
      Enabled: true
      Topic:
        Value: /odom
      Keep: 300
      Shape:
        Value: Axes
        Axes Length: 0.1
        Axes Radius: 0.01

  Enabled: true
  Name: root

Window Geometry:
  Height: 1000
  Width: 1600
  X: 60
  Y: 60

Views:
  Current:
    Class: rviz_default_plugins/Orbit
    Name: Current View
    Distance: 8
    Focal Point:
      X: 0
      Y: 0
      Z: 0
    Yaw: 3.14
    Pitch: 0.6
