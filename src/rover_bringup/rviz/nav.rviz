Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2
Visualization Manager:
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: nav2_rviz_plugins/GoalTool
    - Class: rviz_default_plugins/PublishPoint
      Topic:
        Value: /clicked_point
      Single click: true
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Color: 100; 100; 100
      Cell Size: 1

    - Class: rviz_default_plugins/Map
      Name: Static Map
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
      Color Scheme: map
      Draw Behind: true
      Alpha: 1.0

    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: false
      Show Axes: true
      Marker Scale: 0.3

    - Class: rviz_default_plugins/LaserScan
      Name: Lidar Scan (LD19)
      Enabled: true
      Topic:
        Value: /scan
      Color: 255; 0; 0
      Size (m): 0.04
      Style: Flat Squares

    - Class: rviz_default_plugins/LaserScan
      Name: RealSense Depth Scan
      Enabled: true
      Topic:
        Value: /camera_scan
      Color: 0; 255; 255
      Size (m): 0.04
      Style: Flat Squares

    - Class: rviz_default_plugins/PoseArray
      Name: AMCL Particle Cloud
      Enabled: true
      Topic:
        Value: /particle_cloud
      Color: 0; 180; 0
      Arrow Length: 0.2

    - Class: rviz_common/Group
      Name: Global Planner
      Enabled: true
      Displays:
        - Class: rviz_default_plugins/Map
          Name: Global Costmap
          Enabled: true
          Topic:
            Value: /global_costmap/costmap
            Durability Policy: Transient Local
          Color Scheme: costmap
          Alpha: 0.4
        - Class: rviz_default_plugins/Path
          Name: Global Plan
          Enabled: true
          Topic:
            Value: /plan
          Color: 255; 0; 0
          Line Width: 0.03

    - Class: rviz_common/Group
      Name: Controller
      Enabled: true
      Displays:
        - Class: rviz_default_plugins/Map
          Name: Local Costmap
          Enabled: true
          Topic:
            Value: /local_costmap/costmap
            Durability Policy: Transient Local
          Color Scheme: costmap
          Alpha: 0.6
        - Class: rviz_default_plugins/Path
          Name: Local Plan
          Enabled: true
          Topic:
            Value: /local_plan
          Color: 0; 12; 255
          Line Width: 0.03
        - Class: rviz_default_plugins/Polygon
          Name: Robot Footprint
          Enabled: true
          Topic:
            Value: /local_costmap/published_footprint
          Color: 25; 255; 0

    - Class: rviz_default_plugins/PointCloud2
      Name: RealSense Point Cloud
      Enabled: false
      Topic:
        Value: /camera/camera/depth/color/points
      Style: Flat Squares
      Size (m): 0.01
      Color Transformer: AxisColor
      Axis: Z

  Enabled: true
  Name: root

Window Geometry:
  Height: 1000
  Width: 1700
  X: 60
  Y: 60

Views:
  Current:
    Class: rviz_default_plugins/TopDownOrtho
    Name: Current View
    Scale: 50
    Target Frame: <Fixed Frame>
    X: 0
    Y: 0
